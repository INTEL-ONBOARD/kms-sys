# ==============================================================================
# WISE EAST UNIVERSITY LMS - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MANDATORY)
# ------------------------------------------------------------------------------
# MongoDB connection URI (e.g. MongoDB Atlas cluster connection string)
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority"
# Target database name
MONGODB_DB="wise_east_lms"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY (MANDATORY)
# ------------------------------------------------------------------------------
# Secret key for encrypting and signing JWT tokens (generate via `openssl rand -base64 32`)
JWT_SECRET="your-jwt-secret-min-32-chars-long"

# NextAuth secret key used to sign session cookies (generate via `openssl rand -base64 32`)
NEXTAUTH_SECRET="your-nextauth-secret-min-32-chars-long"

# The canonical public URL of your deployed application
NEXTAUTH_URL="https://lms.wiseeast.edu"

# One-time bootstrap secret key for initializing the super administrator account (/api/setup-admin)
ADMIN_SETUP_SECRET="your-super-secret-admin-bootstrap-token"

# ------------------------------------------------------------------------------
# 3. CLOUDFLARE R2 OBJECT STORAGE (MANDATORY FOR COURSE MATERIALS & ATTACHMENTS)
# ------------------------------------------------------------------------------
# Cloudflare Account ID
R2_ACCOUNT_ID="your_cloudflare_account_id"

# Cloudflare R2 API Access Key ID
R2_ACCESS_KEY_ID="your_r2_access_key_id"

# Cloudflare R2 API Secret Access Key
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"

# Cloudflare R2 Bucket Name for course notes, slides, and assignment files
R2_BUCKET_NAME="lms-course-materials"

# S3 Endpoint URL (https://<ACCOUNT_ID>.r2.cloudflarestorage.com)
R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"

# Public domain or worker URL for public asset downloads (optional if using presigned URLs)
R2_PUBLIC_DOMAIN="https://pub-your-bucket-id.r2.dev"

# ------------------------------------------------------------------------------
# 4. EMAIL & NOTIFICATION DELIVERY (OPTIONAL / PRODUCTION)
# ------------------------------------------------------------------------------
# Resend API Key for sending invitation and reset emails
RESEND_API_KEY="re_123456789"

# Or standard SMTP server configuration
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT="587"
SMTP_USER="apikey"
SMTP_PASS="your-smtp-api-key"
SMTP_FROM="Wise East University <no-reply@wiseeast.edu>"